{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fraware/awesome-scientific-interoperability/blob/main/schema/catalog.schema.json",
  "title": "Awesome Scientific Interoperability catalog",
  "type": "object",
  "required": [
    "catalog_version",
    "reviewed_on",
    "north_star",
    "resources"
  ],
  "additionalProperties": false,
  "properties": {
    "catalog_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "north_star": {
      "type": "string",
      "minLength": 40
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "$defs": {
    "resourceId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "url",
        "section",
        "resource_type",
        "interoperability_layers",
        "connects",
        "mechanism",
        "summary",
        "maturity",
        "evidence_types",
        "implementation_status",
        "conformance_status",
        "stewardship",
        "domains",
        "source_urls",
        "alternatives",
        "related_resource_ids",
        "decision_basis",
        "boundary_note",
        "reviewed_on",
        "review_due_on",
        "primary_source_inspected"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/resourceId"
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "section": {
          "enum": [
            "Foundations",
            "Identifiers and Discovery",
            "Metadata and Semantics",
            "Data and Digital Objects",
            "Research Software and Environments",
            "Workflows and Execution",
            "Provenance and Evidence",
            "Knowledge Systems and Publications",
            "Instruments and Laboratories",
            "Agents, Access, and Policy",
            "Validation and Conformance"
          ]
        },
        "resource_type": {
          "type": "string",
          "minLength": 2
        },
        "interoperability_layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Syntactic",
              "Semantic",
              "Operational",
              "Evidentiary",
              "Organizational"
            ]
          }
        },
        "connects": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "mechanism": {
          "type": "string",
          "minLength": 10
        },
        "summary": {
          "type": "string",
          "minLength": 20,
          "pattern": "^[A-Z0-9].*\\.$"
        },
        "maturity": {
          "enum": [
            "established",
            "maintained",
            "emerging"
          ]
        },
        "evidence_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "normative-specification",
              "reference-implementation",
              "independent-implementation",
              "institutional-adoption",
              "conformance-suite",
              "public-validator",
              "interoperability-demonstration"
            ]
          }
        },
        "implementation_status": {
          "enum": [
            "multiple-independent",
            "reference-and-others",
            "single-known",
            "not-applicable",
            "unknown"
          ]
        },
        "conformance_status": {
          "enum": [
            "public-suite",
            "public-validator",
            "documented-tests",
            "none-known",
            "not-applicable"
          ]
        },
        "stewardship": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "type",
            "url"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 2
            },
            "type": {
              "enum": [
                "standards-body",
                "consortium",
                "foundation",
                "institution",
                "community",
                "vendor-led"
              ]
            },
            "url": {
              "$ref": "#/$defs/httpsUrl"
            }
          }
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "source_urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/httpsUrl"
          }
        },
        "alternatives": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/resourceId"
          }
        },
        "related_resource_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/resourceId"
          }
        },
        "decision_basis": {
          "type": "string",
          "minLength": 20
        },
        "boundary_note": {
          "type": "string",
          "minLength": 10
        },
        "reviewed_on": {
          "type": "string",
          "format": "date"
        },
        "review_due_on": {
          "type": "string",
          "format": "date"
        },
        "primary_source_inspected": {
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "implementation_status": {
                "const": "multiple-independent"
              }
            },
            "required": [
              "implementation_status"
            ]
          },
          "then": {
            "properties": {
              "source_urls": {
                "minItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "conformance_status": {
                "enum": [
                  "public-suite",
                  "public-validator"
                ]
              }
            },
            "required": [
              "conformance_status"
            ]
          },
          "then": {
            "properties": {
              "source_urls": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
