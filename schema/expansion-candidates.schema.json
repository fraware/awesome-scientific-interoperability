{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scientific interoperability corpus expansion candidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expansion_version",
    "reviewed_on",
    "north_star",
    "scope",
    "candidates",
    "research_program_size",
    "completed_candidate_ids"
  ],
  "properties": {
    "expansion_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "north_star": {
      "type": "string",
      "minLength": 40
    },
    "scope": {
      "type": "string",
      "minLength": 40
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "research_program_size": {
      "type": "integer",
      "minimum": 1
    },
    "completed_candidate_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    }
  },
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "official_url",
        "candidate_section",
        "coverage_family",
        "priority",
        "disposition",
        "mechanism",
        "why_distinct",
        "primary_sources",
        "evidence_notes",
        "next_step"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "official_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "candidate_section": {
          "enum": [
            "Foundations",
            "Identifiers and Discovery",
            "Metadata and Semantics",
            "Data and Digital Objects",
            "Research Software and Environments",
            "Workflows and Execution",
            "Provenance and Evidence",
            "Knowledge Systems and Publications",
            "Instruments and Laboratories",
            "Agents, Access, and Policy",
            "Validation and Conformance"
          ]
        },
        "coverage_family": {
          "$ref": "#/$defs/slug"
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2"
          ]
        },
        "disposition": {
          "enum": [
            "admission-pr",
            "boundary-review",
            "watchlist"
          ]
        },
        "mechanism": {
          "type": "string",
          "minLength": 30
        },
        "why_distinct": {
          "type": "string",
          "minLength": 30
        },
        "primary_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/httpsUrl"
          }
        },
        "evidence_notes": {
          "type": "string",
          "minLength": 25
        },
        "next_step": {
          "type": "string",
          "minLength": 20
        },
        "current_repository_state": {
          "enum": [
            "watchlist"
          ]
        }
      }
    }
  }
}
