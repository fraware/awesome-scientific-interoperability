{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fraware/awesome-scientific-interoperability/blob/main/schema/stewards.schema.json",
  "title": "Catalog steward identities registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["stewards_version", "reviewed_on", "stewards"],
  "properties": {
    "stewards_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "reviewed_on": {"type": "string", "format": "date"},
    "stewards": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/steward"}
    }
  },
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "steward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "url", "aliases"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 2},
        "type": {
          "enum": [
            "standards-body",
            "consortium",
            "foundation",
            "institution",
            "community",
            "vendor-led"
          ]
        },
        "url": {"$ref": "#/$defs/httpsUrl"},
        "aliases": {
          "type": "array",
          "items": {"type": "string", "minLength": 2}
        }
      }
    }
  }
}
