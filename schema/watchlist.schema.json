{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fraware/awesome-scientific-interoperability/blob/main/schema/watchlist.schema.json",
  "title": "Awesome Scientific Interoperability watchlist",
  "type": "object",
  "required": ["watchlist_version", "reviewed_on", "items"],
  "additionalProperties": false,
  "properties": {
    "watchlist_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "reviewed_on": {"type": "string", "format": "date"},
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "itemId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "httpsUrl": {"type": "string", "format": "uri", "pattern": "^https://"},
    "candidateSection": {
      "enum": [
        "Foundations", "Identifiers and Discovery", "Metadata and Semantics",
        "Data and Digital Objects", "Research Software and Environments",
        "Workflows and Execution", "Provenance and Evidence",
        "Knowledge Systems and Publications", "Instruments and Laboratories",
        "Agents, Access, and Policy", "Validation and Conformance"
      ]
    },
    "status": {
      "enum": ["monitor", "needs-evidence", "needs-boundary-decision", "superseded", "rejected"]
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_id", "role"],
      "properties": {
        "ref_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "role": {
          "enum": [
            "technical-definition",
            "stewardship",
            "implementation",
            "adoption",
            "conformance",
            "interoperability-testing",
            "maintenance",
            "limitations"
          ]
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "url", "candidate_section", "status", "reason",
        "missing_evidence", "reviewed_on", "review_due_on",
        "promotion_conditions", "rejection_conditions", "source_refs"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/itemId"},
        "name": {"type": "string", "minLength": 2},
        "url": {"$ref": "#/$defs/httpsUrl"},
        "candidate_section": {"$ref": "#/$defs/candidateSection"},
        "status": {"$ref": "#/$defs/status"},
        "reason": {"type": "string", "minLength": 10},
        "missing_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
        "reviewed_on": {"type": "string", "format": "date"},
        "review_due_on": {"type": "string", "format": "date"},
        "promotion_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
        "rejection_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}}
      }
    }
  }
}
