{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fraware/awesome-scientific-interoperability/blob/main/schema/implementations.schema.json",
  "title": "Catalog implementation independence registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["implementations_version", "reviewed_on", "implementations"],
  "properties": {
    "implementations_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "implementations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/implementation"
      }
    }
  },
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "slugId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "url",
        "implements_resource_id",
        "operator_steward_id",
        "relationship",
        "evidence_ref_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slugId"
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "implements_resource_id": {
          "$ref": "#/$defs/slugId"
        },
        "operator_steward_id": {
          "$ref": "#/$defs/slugId"
        },
        "relationship": {
          "enum": [
            "reference-implementation",
            "independent-implementation",
            "official-implementation",
            "validator",
            "conformance-suite"
          ]
        },
        "supported_versions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_ref_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/slugId"
          }
        },
        "multi_org_steward_exception": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "minLength": 8
        }
      }
    }
  }
}
