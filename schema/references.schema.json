{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fraware/awesome-scientific-interoperability/blob/main/schema/references.schema.json",
  "title": "Catalog technical references registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["references_version", "reviewed_on", "references"],
  "properties": {
    "references_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "reviewed_on": {"type": "string", "format": "date"},
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/reference"}
    }
  },
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "type", "publisher", "accessed_on"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 2},
        "url": {"$ref": "#/$defs/httpsUrl"},
        "type": {
          "enum": [
            "specification",
            "normative-schema",
            "api-documentation",
            "implementation-repository",
            "adoption-evidence",
            "registry-record",
            "validator",
            "conformance-suite",
            "interoperability-result",
            "governance-source",
            "technical-documentation"
          ]
        },
        "publisher": {"type": "string", "minLength": 2},
        "accessed_on": {"type": "string", "format": "date"}
      }
    }
  }
}
